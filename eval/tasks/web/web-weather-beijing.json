{
  "id": "web-weather-beijing",
  "goal": "明日の北京の天気を調べ、最高気温と最低気温を教えて",
  "apps": [],
  "category": "read",
  "partition": "tune",
  "channel": "web",
  "requires": [],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_regex",
      "pattern": "-?\\d+\\s*(°|℃|度)"
    }
  ],
  "maxSteps": 25,
  "timeoutSec": 360,
  "note": "仮想画面を使わず、web_read_pageで結果を読み取り、検証を通過する。"
}
