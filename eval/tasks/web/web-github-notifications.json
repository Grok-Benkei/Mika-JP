{
  "id": "web-github-notifications",
  "goal": "ウェブで私のGitHubの未読通知が何件あるか調べて",
  "apps": [],
  "category": "read",
  "partition": "tune",
  "requires": [
    "signedIn:github.com"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_regex",
      "pattern": "\\d+"
    }
  ],
  "maxSteps": 20,
  "timeoutSec": 300,
  "note": "設定のサイトログインで、事前にGitHubへログインしておく。エージェントは再ログインを要求しない。"
}
