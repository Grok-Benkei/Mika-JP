{
  "id": "web-weather-three-cities",
  "goal": "ウェブの中国天気網（weather.com.cn）で、北京・上海・広州の3都市の明日の最高気温を調べ、それぞれ挙げて",
  "apps": [],
  "category": "read",
  "partition": "tune",
  "channel": "web",
  "requires": [],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_grounded",
      "minItems": 3
    },
    {
      "type": "answer_contains",
      "all": [
        "北京",
        "上海",
        "広州"
      ]
    }
  ],
  "maxSteps": 35,
  "timeoutSec": 480,
  "note": "複数ページの情報をまとめる問題。3都市のページをそれぞれ確認し、気温は画面読み取りを根拠にする。"
}
