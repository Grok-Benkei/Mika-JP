{
  "id": "web-rivers-length-compare",
  "goal": "ウェブで長江と黄河の全長をそれぞれ調べ、どちらが長いかと、およそ何キロメートルの差があるかを教えて",
  "apps": [],
  "category": "read",
  "partition": "tune",
  "channel": "web",
  "requires": [],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_contains",
      "all": [
        "長江"
      ]
    },
    {
      "type": "answer_regex",
      "pattern": "\\d{3,4}\\s*(余り)?\\s*(キロメートル|キロ|km)"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "note": "複数ページの情報をまとめる問題。両方の川を個別に調べる。長江は約6300キロメートル、黄河は約5464キロメートル、差は約800〜900キロメートル。判定は結論と単位付きの数値を照合する。"
}
