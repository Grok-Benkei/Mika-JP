{
  "id": "web-mix-android-version-check",
  "goal": "ウェブでAndroidの最新安定版を調べてから、システム設定でこのスマホのAndroidのバージョンを確認し、両方の番号と、このスマホが最新版かを教えて。閲覧だけにして、設定変更やシステム更新の操作はしないで",
  "apps": [
    "com.android.settings"
  ],
  "category": "read",
  "partition": "holdout",
  "requires": [
    "installed:com.android.settings"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_contains",
      "all": [
        "{probe:rel}"
      ]
    }
  ],
  "maxSteps": 40,
  "timeoutSec": 540,
  "probesBefore": {
    "rel": "android_release"
  },
  "note": "端末のバージョンはプローブで照合する。最新安定版は変わるため固定値では照合しない。"
}
