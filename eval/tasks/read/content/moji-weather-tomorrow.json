{
  "id": "moji-weather-tomorrow",
  "goal": "墨迹天气で、現在の都市の明日の最高気温と最低気温を教えて。閲覧だけにして、都市の追加や共有はしないで",
  "apps": [
    "com.moji.mjweather"
  ],
  "category": "read",
  "partition": "holdout",
  "requires": [
    "installed:com.moji.mjweather"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_grounded",
      "minItems": 2
    },
    {
      "type": "answer_regex",
      "pattern": "最高[\\s\\S]*最低|最低[\\s\\S]*最高|\\d+\\s*°?\\s*[~～\\-—至]\\s*\\d+"
    }
  ],
  "maxSteps": 35,
  "timeoutSec": 480
}
