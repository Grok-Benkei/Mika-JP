{
  "id": "weibo-ambiguous-account",
  "goal": "あの人のWeiboの最新投稿に何が書かれているか調べて。閲覧だけにして、高評価・コメント・リポスト・フォローはしないで",
  "apps": [
    "com.sina.weibo"
  ],
  "category": "read",
  "partition": "holdout",
  "requires": [
    "installed:com.sina.weibo"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "asked_user",
      "expected": true
    },
    {
      "type": "answer_grounded",
      "minItems": 1
    }
  ],
  "maxSteps": 40,
  "timeoutSec": 600,
  "answers": {
    "誰": "央视新闻",
    "どの": "央视新闻",
    "どなた": "央视新闻",
    "アカウント": "央视新闻",
    "投稿者": "央视新闻"
  },
  "note": "「あの人」が誰かは本人しか分からないため、先に質問する。自動回答で「央视新闻」を指定してから確認を進める。"
}
