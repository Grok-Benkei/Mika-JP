{
  "id": "baidu-hot-search",
  "goal": "百度アプリで検索トレンドの上位3件を教えて。閲覧だけにして、高評価・コメント・フォロー・共有はしないで",
  "apps": [
    "com.baidu.searchbox"
  ],
  "category": "read",
  "partition": "tune",
  "requires": [
    "installed:com.baidu.searchbox"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_grounded",
      "minItems": 3
    }
  ],
  "maxSteps": 35,
  "timeoutSec": 480
}
