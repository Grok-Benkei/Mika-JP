{
  "id": "weibo-account-followers",
  "goal": "Weiboで「人民日报」のアカウントを検索し、フォロワー数を教えて。閲覧だけにして、高評価・コメント・フォロー・共有はしないで",
  "apps": [
    "com.sina.weibo"
  ],
  "category": "read",
  "partition": "tune",
  "requires": [
    "installed:com.sina.weibo"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_grounded",
      "minItems": 1
    },
    {
      "type": "answer_regex",
      "pattern": "フォロワー[^\\n\\d]{0,8}\\d|\\d[\\d.,]*\\s*[万億]?\\s*(人|名)?\\s*フォロワー"
    }
  ],
  "maxSteps": 35,
  "timeoutSec": 480
}
