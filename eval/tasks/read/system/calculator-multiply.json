{
  "id": "calculator-multiply",
  "goal": "スマホ標準の電卓で123×456を計算し、結果を教えて",
  "apps": [
    "{app:calculator}"
  ],
  "category": "read",
  "partition": "holdout",
  "requires": [
    "app:calculator"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_regex",
      "pattern": "56,?088"
    },
    {
      "type": "answer_grounded",
      "minItems": 1
    }
  ],
  "maxSteps": 20,
  "timeoutSec": 420,
  "note": "スマホ標準アプリはパッケージ名を固定せず、実行時にAndroid標準Intentから端末内の対応アプリを探す。",
  "variants": [
    {
      "goal": "スマホ標準の電卓を開き、123×456がいくつか計算して"
    },
    {
      "goal": "スマホ標準の電卓で321×654を計算し、結果を教えて",
      "checks": [
        {
          "type": "answer_regex",
          "pattern": "209,?934"
        },
        {
          "type": "answer_grounded",
          "minItems": 1
        }
      ]
    }
  ]
}
