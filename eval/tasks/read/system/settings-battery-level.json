{
  "id": "settings-battery-level",
  "goal": "システム設定で、現在のバッテリー残量が何パーセントか調べて。閲覧だけにして、設定は変更しないで",
  "apps": [
    "com.android.settings"
  ],
  "category": "read",
  "partition": "tune",
  "requires": [
    "installed:com.android.settings"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_grounded",
      "minItems": 1
    },
    {
      "type": "answer_regex",
      "pattern": "\\d{1,3}\\s*(%|％|パーセント)"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "variants": [
    {
      "goal": "システム設定を開き、バッテリー残量を確認して。閲覧だけにして、設定は変更しないで"
    },
    {
      "goal": "システム設定に表示されたバッテリー残量は何パーセント？閲覧だけにして、設定は変更しないで"
    }
  ]
}
