{
  "id": "calculator-divide",
  "goal": "スマホ標準の電卓で98765÷25を計算し、結果を教えて",
  "apps": [
    "{app:calculator}"
  ],
  "category": "read",
  "partition": "tune",
  "requires": [
    "app:calculator"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_regex",
      "pattern": "3,?950\\.6(?!\\d)"
    },
    {
      "type": "answer_grounded",
      "minItems": 1
    }
  ],
  "maxSteps": 20,
  "timeoutSec": 420,
  "note": "スマホ標準アプリはパッケージ名を固定せず、実行時にAndroid標準Intentから端末内の対応アプリを探す。",
  "variants": [
    {
      "goal": "スマホ標準の電卓を開き、98765÷25がいくつか計算して"
    },
    {
      "goal": "スマホ標準の電卓で1234÷8を計算し、結果を教えて",
      "checks": [
        {
          "type": "answer_regex",
          "pattern": "154\\.25(?!\\d)"
        },
        {
          "type": "answer_grounded",
          "minItems": 1
        }
      ]
    }
  ]
}
