{
  "id": "settings-kernel-version",
  "goal": "システム設定の端末情報からカーネルバージョンを探し、番号を教えて。閲覧だけにして、設定は変更しないで",
  "apps": [
    "com.android.settings"
  ],
  "category": "read",
  "partition": "tune",
  "requires": [
    "installed:com.android.settings"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_regex",
      "pattern": "\\d+(\\.\\d+){1,}"
    },
    {
      "type": "answer_grounded",
      "minItems": 1
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "variants": [
    {
      "goal": "システム設定の端末情報を開き、カーネルバージョンを確認して。閲覧だけにして、設定は変更しないで"
    },
    {
      "goal": "このスマホのカーネルバージョンはいくつ？システム設定の端末情報で調べて。閲覧だけにして、設定は変更しないで"
    }
  ]
}
