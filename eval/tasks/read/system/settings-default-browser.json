  "apps": [
    "com.android.settings"
  ],
  "category": "read",
  "partition": "tune",
  "requires": [
    "installed:com.android.settings"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_grounded",
      "minItems": 1
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "variants": [
    {
      "goal": "システム設定で、既定のブラウザーに設定されたアプリを確認して。閲覧だけにして、設定は変更しないで"
    },
    {
      "goal": "今のスマホの既定のブラウザーは何？システム設定で調べて。閲覧だけにして、設定は変更しないで"
    }
  ]
}
