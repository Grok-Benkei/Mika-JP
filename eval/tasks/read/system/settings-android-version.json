{
  "id": "settings-android-version",
  "goal": "このスマホのAndroidのバージョンを調べて。閲覧だけにして、設定は変更しないで",
  "apps": [
    "com.android.settings"
  ],
  "category": "read",
  "partition": "tune",
  "requires": [
    "installed:com.android.settings"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_contains",
      "all": [
        "{probe:release}"
      ]
    }
  ],
  "maxSteps": 25,
  "timeoutSec": 420,
  "probesBefore": {
    "release": "android_release"
  },
  "variants": [
    {
      "goal": "このスマホのAndroidは何版？設定で確認して教えて。閲覧だけにして、設定は変更しないで"
    },
    {
      "goal": "システム設定を開き、Androidのバージョン番号を調べて。閲覧だけにして、設定は変更しないで"
    }
  ]
}
