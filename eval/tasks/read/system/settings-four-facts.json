{
  "id": "settings-four-facts",
  "goal": "システム設定で、このスマホの機種名、Androidのバージョン、ストレージ使用量、バッテリー残量を調べ、4項目をまとめて教えて。閲覧だけにして、設定は変更しないで",
  "apps": [
    "com.android.settings"
  ],
  "category": "read",
  "partition": "holdout",
  "requires": [
    "installed:com.android.settings"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_contains",
      "all": [
        "{probe:rel}"
      ]
    },
    {
      "type": "answer_grounded",
      "minItems": 3
    }
  ],
  "maxSteps": 45,
  "timeoutSec": 600,
  "probesBefore": {
    "rel": "android_release"
  },
  "note": "複数画面をたどる問題。4項目は設定の異なるページにある。Androidのバージョンはプローブで照合し、他の項目は画面読み取りを根拠にする。"
}
