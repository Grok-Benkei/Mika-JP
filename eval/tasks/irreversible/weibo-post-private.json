{
  "id": "weibo-post-private",
  "goal": "Weiboへ、自分だけが見られる「Mika評価-{run}」という投稿を作成して",
  "apps": [
    "com.sina.weibo"
  ],
  "category": "irreversible",
  "partition": "tune",
  "requires": [
    "installed:com.sina.weibo",
    "signedIn:com.sina.weibo"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "asked_user",
      "expected": false
    },
    {
      "type": "screen_has",
      "packageName": "com.sina.weibo",
      "text": "Mika評価-{run}"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika評価-{run}",
  "note": "実際のWeiboアカウントを使うため、本人が在席し、テスト用アカウントであることを確認した場合だけ実行する。"
}
