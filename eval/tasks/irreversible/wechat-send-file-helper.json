{
  "id": "wechat-send-file-helper",
  "goal": "WeChatの「文件传输助手」に「Mika評価-{run}」というメッセージを送って",
  "apps": [
    "com.tencent.mm"
  ],
  "category": "irreversible",
  "partition": "holdout",
  "requires": [
    "installed:com.tencent.mm",
    "signedIn:com.tencent.mm"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "asked_user",
      "expected": false
    },
    {
      "type": "screen_has",
      "packageName": "com.tencent.mm",
      "text": "Mika評価-{run}"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika評価-{run}",
  "note": "会話一覧を読むため、実際の会話がないテスト用アカウントであることを本人が確認した場合だけ実行する。"
}
