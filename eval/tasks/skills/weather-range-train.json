{
  "id": "weather-range-train",
  "goal": "スマホ標準の天気アプリを開き、現在の都市の今日の最高気温と最低気温を教えて。閲覧だけにして、都市の追加や削除はしないで",
  "apps": [
    "{app:weather}"
  ],
  "category": "read",
  "partition": "tune",
  "requires": [],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_grounded",
      "minItems": 2
    },
    {
      "type": "answer_regex",
      "pattern": "最高[\\s\\S]*最低|最低[\\s\\S]*最高|\\d+\\s*°?\\s*[~～\\-—至]\\s*\\d+"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "note": "スマホ標準アプリはパッケージ名を固定せず、実行時にAndroid標準Intentから端末内の対応アプリを探す。",
  "split": "train"
}
