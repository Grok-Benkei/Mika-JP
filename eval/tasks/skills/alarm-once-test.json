{
  "id": "alarm-once-test",
  "goal": "スマホ標準の時計で8:05に1回だけ鳴るアラームを作り、名前を「Mika評価-{run}-アラーム乙」にして",
  "apps": [
    "{app:alarm}"
  ],
  "category": "write",
  "partition": "tune",
  "requires": [
    "app:alarm"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "screen_has",
      "packageName": "{app:alarm}",
      "text": "Mika評価-{run}-アラーム乙"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika評価-{run}-アラーム乙",
  "note": "スマホ標準アプリはパッケージ名を固定せず、実行時にAndroid標準Intentから端末内の対応アプリを探す。",
  "split": "test"
}
