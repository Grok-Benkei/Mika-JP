{
  "id": "calendar-allday-train",
  "goal": "スマホ標準のカレンダーに明後日の終日予定を作り、タイトルを「Mika評価-{run}-終日甲」にして。誰も招待しないで",
  "apps": [
    "{app:calendar}"
  ],
  "category": "write",
  "partition": "holdout",
  "requires": [
    "app:calendar"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "screen_has",
      "packageName": "{app:calendar}",
      "text": "Mika評価-{run}-終日甲"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika評価-{run}-終日甲",
  "note": "スマホ標準アプリはパッケージ名を固定せず、実行時にAndroid標準Intentから端末内の対応アプリを探す。",
  "split": "train"
}
