{
  "id": "calc-sub-test",
  "goal": "スマホ標準の電卓で52300−8765を計算し、結果を教えて",
  "apps": [
    "{app:calculator}"
  ],
  "category": "read",
  "partition": "tune",
  "requires": [
    "app:calculator"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_regex",
      "pattern": "43,?535(?!\\d)"
    },
    {
      "type": "answer_grounded",
      "minItems": 1
    }
  ],
  "maxSteps": 20,
  "timeoutSec": 420,
  "note": "スマホ標準アプリはパッケージ名を固定せず、実行時にAndroid標準Intentから端末内の対応アプリを探す。",
  "split": "test"
}
