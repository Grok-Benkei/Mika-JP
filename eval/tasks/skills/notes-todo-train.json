{
  "id": "notes-todo-train",
  "goal": "スマホ標準のメモのToDoに「Mika評価-{run}-ToDo甲」を作成して",
  "apps": [
    "{app:notes}"
  ],
  "category": "write",
  "partition": "holdout",
  "requires": [],
  "expect": "succeeded",
  "checks": [
    {
      "type": "screen_has",
      "packageName": "{app:notes}",
      "text": "Mika評価-{run}-ToDo甲"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika評価-{run}-ToDo甲",
  "note": "スマホ標準アプリはパッケージ名を固定せず、実行時にAndroid標準Intentから端末内の対応アプリを探す。",
  "split": "train"
}
