{
  "id": "wps-note-create",
  "goal": "WPSメモ（WPS便签）で「Mika評価-{run}-付箋」というメモを作成して保存して",
  "apps": [
    "cn.wps.note"
  ],
  "category": "write",
  "partition": "tune",
  "requires": [
    "installed:cn.wps.note"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "screen_has",
      "packageName": "cn.wps.note",
      "text": "Mika評価-{run}-付箋"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika評価-{run}-付箋"
}
