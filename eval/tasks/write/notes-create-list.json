{
  "id": "notes-create-list",
  "goal": "スマホ標準のメモで、1行目を「Mika評価-{run}-リスト」、続く2行を「土曜日は登山」「日曜日は読書」にしたメモを作成して保存して",
  "apps": [
    "{app:notes}"
  ],
  "category": "write",
  "partition": "tune",
  "requires": [],
  "expect": "succeeded",
  "checks": [
    {
      "type": "screen_has",
      "packageName": "{app:notes}",
      "text": "Mika評価-{run}-リスト"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika評価-{run}-リスト",
  "note": "スマホ標準アプリはパッケージ名を固定せず、実行時にAndroid標準Intentから端末内の対応アプリを探す。"
}
