{
  "id": "alarm-workday",
  "goal": "スマホ標準の時計で平日の6:40に鳴るアラームを作り、名前を「Mika評価-{run}-平日」にして",
  "apps": [
    "{app:alarm}"
  ],
  "category": "write",
  "partition": "tune",
  "requires": [
    "app:alarm"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "screen_has",
      "packageName": "{app:alarm}",
      "text": "Mika評価-{run}-平日"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika評価-{run}-平日",
  "note": "スマホ標準アプリはパッケージ名を固定せず、実行時にAndroid標準Intentから端末内の対応アプリを探す。"
}
