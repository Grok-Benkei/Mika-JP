{
  "id": "contact-draft",
  "goal": "スマホ標準の連絡先で「Mika評価-{run}-連絡先」を新規作成し、電話番号など他の項目は空欄のまま保存して",
  "apps": [
    "{app:contacts}"
  ],
  "category": "write",
  "partition": "holdout",
  "requires": [
    "app:contacts"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "screen_has",
      "packageName": "{app:contacts}",
      "text": "Mika評価-{run}-連絡先"
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika評価-{run}-連絡先",
  "note": "スマホ標準アプリはパッケージ名を固定せず、実行時にAndroid標準Intentから端末内の対応アプリを探す。"
}
