{
  "id": "mem-notes-2-use",
  "goal": "スマホ標準のメモで「月報」というメモを作成して保存して",
  "apps": [
    "{app:notes}"
  ],
  "category": "write",
  "partition": "tune",
  "requires": [],
  "expect": "succeeded",
  "checks": [
    {
      "type": "screen_has",
      "packageName": "{app:notes}",
      "text": "Mika評価-{run}-月報"
    },
    {
      "type": "memory_used",
      "min": 1
    }
  ],
  "maxSteps": 30,
  "timeoutSec": 420,
  "marker": "Mika評価-{run}-月報",
  "note": "スマホ標準アプリはパッケージ名を固定せず、実行時にAndroid標準Intentから端末内の対応アプリを探す。2問目の依頼では接頭辞を意図的に省き、記憶から補うことを確認する。",
  "session": "mem-notes"
}
