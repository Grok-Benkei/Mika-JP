{
  "id": "mem-decimals-1-tell",
  "goal": "覚えておいて。今後、割り算の結果は小数点以下2桁で表示して。まずスマホ標準の電卓で10÷4を計算して",
  "apps": [
    "{app:calculator}"
  ],
  "category": "read",
  "partition": "holdout",
  "requires": [
    "app:calculator"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_regex",
      "pattern": "2\\.50?(?!\\d)"
    },
    {
      "type": "answer_grounded",
      "minItems": 1
    }
  ],
  "maxSteps": 20,
  "timeoutSec": 420,
  "note": "スマホ標準アプリはパッケージ名を固定せず、実行時にAndroid標準Intentから端末内の対応アプリを探す。2問目では、1問目で伝えた好みを記憶から利用する。",
  "session": "mem-decimals"
}
