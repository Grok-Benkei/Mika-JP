{
  "id": "mem-area-1-tell",
  "goal": "覚えておいて。今後、面積を計算するときは結果に「平方メートル」の単位を付けて。まずスマホ標準の電卓で12×8の面積を計算して",
  "apps": [
    "{app:calculator}"
  ],
  "category": "read",
  "partition": "tune",
  "requires": [
    "app:calculator"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_regex",
      "pattern": "96\\s*平方メートル"
    },
    {
      "type": "answer_grounded",
      "minItems": 1
    }
  ],
  "maxSteps": 20,
  "timeoutSec": 420,
  "note": "スマホ標準アプリはパッケージ名を固定せず、実行時にAndroid標準Intentから端末内の対応アプリを探す。2問目では、1問目で伝えた好みを記憶から利用する。",
  "session": "mem-area"
}
