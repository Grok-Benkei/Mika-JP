{
  "id": "mem-rate-2-use",
  "goal": "スマホ標準の電卓で250×為替レートを計算して",
  "apps": [
    "{app:calculator}"
  ],
  "category": "read",
  "partition": "holdout",
  "requires": [
    "app:calculator"
  ],
  "expect": "succeeded",
  "checks": [
    {
      "type": "answer_regex",
      "pattern": "1,?775(?!\\d)"
    },
    {
      "type": "answer_grounded",
      "minItems": 1
    },
    {
      "type": "memory_used",
      "min": 1
    }
  ],
  "maxSteps": 20,
  "timeoutSec": 420,
  "note": "スマホ標準アプリはパッケージ名を固定せず、実行時にAndroid標準Intentから端末内の対応アプリを探す。2問目では、1問目で伝えた好みを記憶から利用する。",
  "session": "mem-rate"
}
