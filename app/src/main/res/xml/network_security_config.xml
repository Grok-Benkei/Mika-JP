<?xml version="1.0" encoding="utf-8"?>
<!--
  はプレーン テキスト http を許可します。ローカル マシンまたは LAN 上でユーザーによって実行されるほとんどのモデル サービス (http://192.168.1.10:11434/v1 など) には http のみがあります。
  証明書は、システムのデフォルトで信頼されます (システム証明書のみが信頼されます)。したがって、内蔵ブラウザは http Web ページを直接開くこともできます (最初にシステムによって拒否され、その後 https に変更して再試行することはなくなりました)。
  サービス プロバイダーを追加する場合、暗号化されておらず、ローカル エリア ネットワーク上にないアドレスを指定するプロンプトが表示されます (LocalHosts を参照)。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
