<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- プローブ ページは、Mika プロセスのテストにレコードをブロードキャストします -->
    <queries>
        <package android:name="com.wangzan101.mika" />
        <!-- 「ユーザーのホーム画面を開く」ページを再現するには、他のアプリの起動入り口を取得する必要があります -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application>
        <!-- 端末の言語を変えず、非日本語 Context のロケール適用と実 Activity の構成変更を検査する。 -->
        <activity android:name="com.wangzan101.mika.i18n.LocaleConfigTestActivity"
            android:exported="true" android:excludeFromRecents="true" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity android:name="com.wangzan101.mika.cap.phone.display.RotationTestActivity"
            android:exported="true" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <!-- テスト ページ、テスト開始によって仮想画面が開きます。これらは、Kotlin 標準ライブラリを使用せずに、テスト パッケージ独自のプロセスで実行されます。
             つまり、Java で書かれています。クラス名はソース ファイル内のクラス名と一致している必要があります (ManifestProvidersTest がチェックします)。 -->
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.SecureTestActivity" android:exported="true" />
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.PlainTestActivity" android:exported="true" />
        <activity android:name="com.wangzan101.mika.a11y.WebEditorTestActivity" android:exported="true" />
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.FieldsTestActivity" android:exported="true" />
        <!-- スクロール ホイール テスト ページ: 2 つのオリジナル デジタル スクロール ホイール -->
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.WheelPickerTestActivity" android:exported="true" />
        <!-- アプリケーション コンテキストから別のアプリを開く: 「ユーザーのホーム画面を開く」を再現します。 -->
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.SpillTestActivity" android:exported="true" />
        <!-- ダイアログ スタイル ページ: ユーザーがホーム画面で確認をクリックする必要があるログイン確認ポップアップ ウィンドウを再現します。 -->
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.DialogSpillTestActivity" android:exported="true"
            android:theme="@android:style/Theme.Material.Dialog" />
        <!-- 全画面アカウントログインページ: 通常のアプリページと形状は同じです。 「それが含まれているパッケージがデスクトップアイコンのないアカウント認証システムである」だけがそれを認識できます。 -->
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.FullScreenAuthTestActivity" android:exported="true" />
        <!-- テスト パッケージのアカウント認証機能は、デフォルトではオフになっています。これは AuthSpillDeviceTest でのみオンになり、テスト後にオフになります。戻されても、他のテストは影響を受けません。
             テスト パッケージには LAUNCHER エントリがありません。開いてみると、デスクトップアイコンのないアカウント認証パッケージです。 -->
        <service android:name="com.wangzan101.mika.cap.phone.a11y.TestAuthenticatorService" android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/test_authenticator" />
        </service>
        <service android:name="com.wangzan101.mika.cap.phone.a11y.SpillLaunchService" android:process=":spill" android:exported="false" />
        <!-- シェル比較テストのプローブ ページ: startApp は起動入り口 (INFO、デスクトップには入らない) を取得し、startView はカスタム リンクを取得します。 -->
        <activity android:name="com.wangzan101.mika.shell.ShellProbeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mika-parity" />
            </intent-filter>
        </activity>
        <!-- 音を出し続けるプローブページ (無音のループ): タスク終了時に音を鳴らすアプリはデフォルトでオフになります -->
        <activity android:name="com.wangzan101.mika.shell.AudioProbeActivity" android:exported="true" />
    </application>
</manifest>
